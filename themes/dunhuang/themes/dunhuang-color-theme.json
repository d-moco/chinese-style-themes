  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#A88E70",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python"
      ],
      "settings": {
        "foreground": "#EF8A5A"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.terminator",
        "meta.brace",
        "punctuation"
      ],
      "settings": {
        "foreground": "#C4AE90"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#7DC4A0"
      }
    },
    {
      "scope": [
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#9FD0C0"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "support.constant",
        "variable.other.constant",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#E8C070"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#6FB4D6"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type",
        "entity.other.inherited-class",
        "storage.type.primitive",
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#9FD0C0"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other.readwrite",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#F0E2C8"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#E4CCA8",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.self"
      ],
      "settings": {
        "foreground": "#D8A0B0",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#EF8A5A"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#E8C070",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#D8A0B0"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key",
        "variable.other.property",
        "variable.other.object.property"
      ],
      "settings": {
        "foreground": "#DCCAB0"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#EF8A5A",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#F0E2C8",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#F0E2C8",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#7DC4A0"
      }
    },
    {
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#6FB4D6",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#7DC4A0"
      }
    },
    {
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#F07060"
      }
    },
    {
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#6FB4D6"
      }
    },
    {
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#F07060",
        "fontStyle": "underline"
      }
    }
  ],
  "semanticTokenColors": {
    "keyword": "#EF8A5A",
    "string": "#7DC4A0",
    "number": "#E8C070",
    "regexp": "#9FD0C0",
    "comment": {
      "foreground": "#A88E70",
      "italic": true
    },
    "function": "#6FB4D6",
    "method": "#6FB4D6",
    "macro": "#D8A0B0",
    "class": "#9FD0C0",
    "interface": "#9FD0C0",
    "enum": "#9FD0C0",
    "struct": "#9FD0C0",
    "type": "#9FD0C0",
    "typeParameter": {
      "foreground": "#9FD0C0",
      "italic": true
    },
    "namespace": "#9FD0C0",
    "parameter": {
      "foreground": "#E4CCA8",
      "italic": true
    },
    "variable": "#F0E2C8",
    "variable.readonly": "#E8C070",
    "property": "#DCCAB0",
    "enumMember": "#E8C070",
    "decorator": "#D8A0B0",
    "*.deprecated": {
      "strikethrough": true
    },
    "selfKeyword": {
      "foreground": "#D8A0B0",
      "italic": true
    }
  }
}